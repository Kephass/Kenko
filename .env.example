# --- Edge function (local testing with `supabase functions serve`) ---
# In production these two are injected automatically by Supabase - never set
# them yourself there.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Set in production with: supabase secrets set AI_PROVIDER_API_KEY=sk-...
AI_PROVIDER_API_KEY=

# --- Offline tooling (scripts/) ---
# Direct Postgres connection string, from the Supabase dashboard
# (Settings -> Database -> Connection string).
SUPABASE_DB_URL=

# --- Client ---
# The client reads its own client/.env.local (not this file):
#   NEXT_PUBLIC_SUPABASE_URL=
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Publishable key only - the service role key never goes in client code.
